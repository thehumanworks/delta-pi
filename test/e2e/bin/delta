#!/usr/bin/env -S node --no-warnings
// The fake Delta CLI (test/fake-delta/cli.ts) as the `delta` program the end-to-end tests put on the PATH.
import { existsSync, readFileSync } from 'node:fs'
import { enableCompileCache } from 'node:module'

// Each command is a new process; caching the compiled fake keeps them quick.
enableCompileCache()
const { fakeDelta } = await import('../../fake-delta/cli.ts')

const code = await fakeDelta(process.argv.slice(2), {
  env: process.env,
  stdin: () => readFileSync(0, 'utf8'),
  write: (stream, text) => process[stream].write(text),
  hold: (onStop, poll) =>
    new Promise(() => {
      const stop = () => {
        try {
          // A test that already cleaned up its state keeps nothing a late stop could change.
          if (process.env.FAKE_DELTA_STATE && existsSync(process.env.FAKE_DELTA_STATE)) onStop?.()
        } finally {
          process.exit(0)
        }
      }
      process.on('SIGTERM', stop)
      process.on('SIGINT', stop)
      if (poll) setInterval(poll, 50)
      // Like Delta's own long-running commands, this ends when the process that started it is gone.
      const parent = process.ppid
      setInterval(() => {
        if (process.ppid !== parent) stop()
      }, 200)
    }),
})
process.exit(code)
