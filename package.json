{
  "name": "@nothumanwork/pi-delta",
  "version": "0.1.0",
  "type": "module",
  "description": "Make Pi multiplayer: record sessions to Delta threads, share them, and join teammates' threads, powered by DeltaDB",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thehumanworks/delta-pi.git"
  },
  "homepage": "https://github.com/thehumanworks/delta-pi#readme",
  "bugs": {
    "url": "https://github.com/thehumanworks/delta-pi/issues"
  },
  "keywords": [
    "pi-package",
    "delta",
    "deltadb",
    "collaboration"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
