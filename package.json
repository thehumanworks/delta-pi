{
  "name": "@nothumanwork/pi-delta",
  "version": "0.1.0",
  "type": "module",
  "description": "Make Pi multiplayer: record sessions to Delta threads, share them, and join teammates' threads, powered by DeltaDB",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thehumanworks/delta-pi.git"
  },
  "homepage": "https://github.com/thehumanworks/delta-pi#readme",
  "bugs": {
    "url": "https://github.com/thehumanworks/delta-pi/issues"
  },
  "keywords": [
    "pi-package",
    "delta",
    "deltadb",
    "collaboration"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint . && node scripts/ast-grep.mjs scan && node scripts/ast-grep.mjs test --skip-snapshot-tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:behaviour": "vitest run --project behaviour",
    "test:e2e": "vitest run --project e2e",
    "verify": "npm run format:check && npm run check && npm run lint && npm test",
    "prepublishOnly": "npm run verify",
    "test:package": "node scripts/test-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.1",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
